{
  "name": "saphirs-toolbox",
  "version": "1.1.0",
  "description": "Saphir's Toolbox",
  "main": "dist-main/main/index.js",
  "author": "Saphir",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently -k -n VITE,ELECTRON -c blue,magenta \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "wait-on tcp:5173 && tsc -p tsconfig.main.json && electron .",
    "compile": "tsc -p tsconfig.main.json && vite build",
    "start": "npm run compile && electron .",
    "icon": "node scripts/build-icon.mjs",
    "build": "tsc -p tsconfig.main.json && vite build && electron-builder --publish never",
    "build:dir": "tsc -p tsconfig.main.json && vite build && electron-builder --dir",
    "release": "tsc -p tsconfig.main.json && vite build && electron-builder --publish always",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "electron-updater": "^6.3.9",
    "marked": "^18.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "to-ico": "^1.1.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.saphir.toolbox",
    "productName": "Saphir's Toolbox",
    "files": [
      "dist-main/**/*",
      "dist-renderer/**/*",
      "assets/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jdsaphir",
        "repo": "saphirs-toolbox"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "SaphirsToolbox-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Saphir's Toolbox",
      "artifactName": "SaphirsToolbox-${version}-setup.exe"
    }
  }
}
